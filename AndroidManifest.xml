<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.antigravity.screenresizer">
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <application android:allowBackup="true" android:banner="@drawable/banner" android:debuggable="true" android:icon="@drawable/icon" android:isGame="false" android:label="@string/app_name" android:supportsRtl="true">
        <activity android:exported="true" android:label="@string/app_name" android:name="com.antigravity.screenresizer.MainActivity" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver android:exported="true" android:name="com.antigravity.screenresizer.ResizeReceiver">
            <intent-filter>
                <action android:name="com.antigravity.screenresizer.RESIZE"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
